DATABASE_URL="postgresql://amass:amass_secret@localhost:5432/amass_crm?schema=public"

# JWT
JWT_SECRET=dev-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Redis (optional)
REDIS_URL=

# OAuth2 - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 - Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# OAuth redirect base URL (API base URL used for OAuth callbacks)
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
